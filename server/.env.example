# ============================================================
# PKB 个人知识库 · 后端环境变量样例（pkb-server）
# 用法：复制本文件为 server/.env 并填入真实值。
#       .env 已被根 .gitignore 忽略 —— 任何明文密码都不许入仓。
# 生效方式：application.yml 中 spring.config.import=optional:file:./.env[.properties]
#          （工作目录为 server/ 时自动读取 server/.env）
# ============================================================

# ---------- 应用 ----------
# 端口：dev 默认 8080 / prod 默认 8081（在 application-dev|prod.yml 里各自兜底）
APP_PORT=8080
# 环境标识：默认 dev（application.yml 已兜底）
# 注意：不在此处设置 SPRING_PROFILES_ACTIVE，避免与配置文件加载顺序产生歧义
# SPRING_PROFILES_ACTIVE=prod

# ---------- MySQL ----------
# T2 建好 pkb 库与专属账号后填入真实值；应用一律不用 root
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=pkb
MYSQL_USER=pkb_app
MYSQL_PASSWORD=

# ---------- Redis ----------
# 本机开发用的 Windows 版 Redis 无密码，REDIS_PASSWORD 留空即可
# （application-dev.yml 中未声明 password 项，避免空串触发 AUTH）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Sa-Token ----------
SA_TOKEN_NAME=pkb-token
# token 有效期（秒）：604800 = 7 天（2026-10-15 拍板，PRD #16）
# ⚠️ 本文件的值会**覆盖** application.yml 里的默认值 —— 改有效期必须两处一起改
SA_TOKEN_TIMEOUT=604800

# ---------- MinIO（P-009 附件，T11 启用）----------
# 凭据留空时应用照常启动，只是附件上传功能不可用（不会拖垮整个服务）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=pkb
# 对象对外公开地址前缀；留空则回退 MINIO_ENDPOINT/MINIO_BUCKET。
# 库表存的是对象 key，读接口现拼这个前缀 —— 换域名时旧附件不会失效
MINIO_PUBLIC_URL=
